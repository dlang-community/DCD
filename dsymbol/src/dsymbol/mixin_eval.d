/**
 * Evaluation of string mixins.
 *
 * DCD does not run a full CTFE engine, but a large class of string mixins
 * (e.g. C binding generator macros) are generated by simple eponymous
 * templates that concatenate string literals with their value parameters.
 * This module implements a small evaluator for exactly that subset:
 *
 * - string literals (including token strings like q{...})
 * - template value parameters of type string
 * - `~` concatenation
 * - eponymous template instantiation `Name!arg` where arg is a string
 *   literal or another template's value parameter (alias forwarding)
 *
 * The result is fed back into the parser by first.d so the generated
 * declarations produce real symbols.
 *
 * The evaluator is owned by a FirstPass instance: the registry holds AST
 * pointers (template bodies) that are only valid while the module's parse
 * allocator is alive, i.e. during FirstPass.run(). Since a string mixin and
 * the template it instantiates are always declared in the same module,
 * recording and consuming within one pass is sufficient.
 */
module dsymbol.mixin_eval;

import dparse.ast;
import dparse.lexer;
import dparse.parser;
import dparse.rollback_allocator;
import dparse.strings : unescapeString;
import dsymbol.conversion : parseModuleSimple;
import dsymbol.scope_;
import dsymbol.symbol;
import dsymbol.string_interning;
import std.string : empty;

/**
 * A string-valued eponymous template, in one of two forms:
 *
 * $(UL
 *     $(LI enum form: `enum X(string name) = "..." ~ name ~ "...";`
 *         where $(D_PARAM body) holds the assign expression)
 *     $(LI alias form (forwarder): `alias X(string name) = Y!name;`
 *         where $(D_PARAM forward) holds the forwarded template instance)
 * )
 */
struct EponymousStringTemplate
{
	/// The template name (e.g. VK_DEFINE_HANDLE)
	istring name;
	/// The single template value parameter's name (e.g. name)
	istring parameterName;
	/// The body expression (enum form)
	ExpressionNode body_;
	/// The forwarded template instance (alias form)
	TemplateInstance forward_;
}

/**
 * Evaluates string mixins for one FirstPass run. Holds the registry of
 * evaluable templates found in the module being parsed and the active
 * parameter bindings during instantiation.
 */
struct MixinEvaluator
{
private:
	/// Templates recorded by the first pass, keyed by their DSymbol.
	EponymousStringTemplate[const(DSymbol)*] registry;

	/// Active template parameter bindings during instantiation. Intentionally
	/// a single flat map: nested instantiations of the same parameter name
	/// with different values are not supported (the depth cap stops runaway
	/// recursion).
	string[string] activeBindings;

	/// Recursion cap for template instantiation chains.
	enum maxInstantiationDepth = 8;

public:

	/**
	 * Records an eponymous template declaration (enum form):
	 * `enum X(string name) = "..." ~ name;`
	 *
	 * Params:
	 *     symbol = the DSymbol created for the template declaration
	 *     parameterName = the name of the single string value parameter
	 *     body = the template's assign expression
	 */
	void recordEponymousTemplate(const(DSymbol)* symbol, istring parameterName,
		const(ExpressionNode) body)
	{
		if (symbol is null || body is null || parameterName is null)
			return;
		auto entry = EponymousStringTemplate(symbol.name, parameterName,
			cast(ExpressionNode) body, null);
		registry[symbol] = entry;
	}
	/**
	 * Records an alias forwarder (alias form):
	 * `alias X(string name) = Y!name;`
	 *
	 * Params:
	 *     symbol = the DSymbol created for the alias declaration
	 *     parameterName = the name of the single string value parameter
	 *     forward = the forwarded template instance (Y!name)
	 */
	void recordAliasForwarder(const(DSymbol)* symbol, istring parameterName,
		const(TemplateInstance) forward)
	{
		if (symbol is null || forward is null || parameterName is null)
			return;
		auto entry = EponymousStringTemplate(symbol.name, parameterName,
			null, cast(TemplateInstance) forward);
		registry[symbol] = entry;
	}

	/**
	 * Tries to evaluate the argument list of `mixin(...)` to a compile-time
	 * string.
	 *
	 * Params:
	 *     expr = the mixin expression
	 *     sc = the current scope, used to look up templates
	 * Returns: the evaluated string, or null if the expression is not
	 *     evaluable by this limited evaluator
	 */
	string evaluate(const MixinExpression expr, Scope* sc)
	{
		if (expr is null || expr.argumentList is null)
			return null;
		if (expr.argumentList.items.length != 1)
			return null;
		return evaluateStringExpression(expr.argumentList.items[0], sc, 0);
	}

private:

	/**
	 * Evaluates an expression to a string.
	 *
	 * Params:
	 *     node = the expression node
	 *     sc = scope for symbol lookup
	 *     depth = current instantiation depth (recursion guard)
	 */
	string evaluateStringExpression(const ExpressionNode node, Scope* sc,
		int depth)
	{
		if (node is null || depth > maxInstantiationDepth)
			return null;

		// The parser wraps primary expressions in UnaryExpression
		// (e.g. the argument of `mixin(...)`)
		if (auto ue = cast(const(UnaryExpression)) node)
		{
			if (ue.primaryExpression is null)
				return null;
			return evaluateStringExpression(ue.primaryExpression, sc, depth);
		}

		// String literal (covers "..." and q{...})
		if (auto pe = cast(const(PrimaryExpression)) node)
		{
			if (pe.primary != tok!"" && isStringLiteral(pe.primary.type))
			{
				try
					return unescapeString(pe.primary.text);
				catch (Exception)
					return null;
			}
			// Identifier: a string value parameter of the enclosing template
			if (pe.identifierOrTemplateInstance !is null)
			{
				if (pe.identifierOrTemplateInstance.identifier != tok!"")
					return lookupStringValue(
						pe.identifierOrTemplateInstance.identifier.text);
				// Template instance: eponymous template instantiation
				return instantiateEponymousTemplate(
					pe.identifierOrTemplateInstance.templateInstance, sc, depth);
			}
			return null;
		}

		// Concatenation: "a" ~ b ~ "c"
		if (auto ae = cast(const(AddExpression)) node)
		{
			string left = evaluateStringExpression(ae.left, sc, depth);
			if (left is null)
				return null;
			string right = evaluateStringExpression(ae.right, sc, depth);
			if (right is null)
				return null;
			return left ~ right;
		}

		// Parenthesized expression
		if (auto e = cast(const(Expression)) node)
		{
			if (e.items.length == 1)
				return evaluateStringExpression(e.items[0], sc, depth);
			return null;
		}

		return null;
	}

	/**
	 * Looks up an identifier's string value. During instantiation this is
	 * the active template parameter binding.
	 */
	string lookupStringValue(string name)
	{
		auto p = name in activeBindings;
		return p is null ? null : *p;
	}

	/**
	 * Instantiates an eponymous string template: `TEMPLATE!arg`.
	 *
	 * The template must have been recorded by the first pass. The single
	 * argument must be a string literal or an identifier bound to the
	 * enclosing template's parameter (forwarder case).
	 */
	string instantiateEponymousTemplate(const TemplateInstance instance,
		Scope* sc, int depth)
	{
		if (instance is null || instance.templateArguments is null)
			return null;
		if (depth > maxInstantiationDepth)
			return null;

		// Evaluate the argument
		string argument;
		if (instance.templateArguments.templateSingleArgument !is null)
		{
			const Token t = instance.templateArguments.templateSingleArgument.token;
			if (isStringLiteral(t.type))
			{
				try
					argument = unescapeString(t.text);
				catch (Exception)
					return null;
			}
			else if (t.type == tok!"identifier")
				argument = lookupStringValue(t.text);
			else
				return null;
		}
		else if (instance.templateArguments.namedTemplateArgumentList !is null)
		{
			auto items = instance.templateArguments.namedTemplateArgumentList.items;
			if (items.length != 1)
				return null;
			const NamedTemplateArgument arg = items[0];
			if (arg.assignExpression is null)
				return null;
			argument = evaluateStringExpression(arg.assignExpression, sc, depth);
		}
		else
			return null;
		if (argument is null)
			return null;

		// Find the template and evaluate its body with the parameter bound.
		auto symbols = sc.getSymbolsByName(istring(instance.identifier.text));
		foreach (sym; symbols)
		{
			auto tmpl = sym in registry;
			if (tmpl is null)
				continue;
			bindTemplateParameter(tmpl.parameterName, argument);
			scope (exit) unbindTemplateParameter(tmpl.parameterName);
			if (tmpl.forward_ !is null)
				return instantiateEponymousTemplate(tmpl.forward_, sc, depth + 1);
			return evaluateStringExpression(tmpl.body_, sc, depth + 1);
		}
		return null;
	}

	void bindTemplateParameter(istring name, string value)
	{
		activeBindings[name.data] = value;
	}

	void unbindTemplateParameter(istring name)
	{
		activeBindings.remove(name.data);
	}
}

/**
 * Parses the generated declarations of a string mixin.
 *
 * Params:
 *     generated = the evaluated mixin string
 *     mixinOffset = byte offset of the mixin declaration in the original
 *         file; the generated source is padded with spaces so that token
 *         indexes are absolute file offsets (go-to-definition etc. keep
 *         working)
 *     allocator = allocator that must outlive the returned declarations.
 *         The AST nodes are allocated from it, so it must not be rolled
 *         back or destroyed while the declarations are in use.
 *     stringCache = interning cache for the generated tokens; must outlive
 *         the returned declarations as well.
 * Returns: the parsed declarations, or an empty array
 */
Declaration[] parseGeneratedDeclarations(string generated, size_t mixinOffset,
	RollbackAllocator* allocator, StringCache* stringCache)
{
	if (generated.empty)
	{
		return [];
	}
	// Pad so token indexes are absolute file offsets.
	auto padded = new char[mixinOffset + generated.length];
	padded[0 .. mixinOffset] = ' ';
	padded[mixinOffset .. $] = generated;

	LexerConfig config;
	config.fileName = "";
	auto tokens = getTokensForParser(cast(ubyte[]) padded, config, stringCache);
	if (tokens.empty)
		return [];

	Module m = parseModuleSimple(tokens[], "", allocator);
	if (m is null || m.declarations.empty)
		return [];
	return m.declarations;
}
